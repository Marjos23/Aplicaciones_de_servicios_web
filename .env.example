# Ambiente de ejecución: development, test o production.
# Fuera de development, TypeORM deja de sincronizar el esquema.
NODE_ENV=development

# Puerto de la API
PORT=3000

# Conexión a PostgreSQL.
# Estos valores son de ejemplo: copia este archivo a `.env` y ajusta
# host, puerto, usuario y contraseña a tu entorno local.
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_NAME=coursehub-api
DATABASE_USER=postgres
DATABASE_PASSWORD=change_me

# Registra las consultas SQL de TypeORM en la terminal.
# Útil para aprender en desarrollo; déjalo en false fuera de él.
DATABASE_LOGGING=false

# JWT
JWT_SECRET=replace-with-a-long-random-local-secret-min-32-chars
JWT_EXPIRES_IN=15m

# Orígenes web autorizados por CORS, separados por comas.
# En producción se declaran explícitamente los del cliente real.
CORS_ORIGINS=http://localhost:5173
