# Puerto de la API
PORT=3000

# Conexión a PostgreSQL.
# Estos valores son de ejemplo: copia este archivo a `.env` y ajusta
# host, puerto, usuario y contraseña a tu entorno local.
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_NAME=coursehub-api
DATABASE_USER=postgres
DATABASE_PASSWORD=change_me

# Registra las consultas SQL de TypeORM en la terminal.
# Útil para aprender en desarrollo; déjalo en false fuera de él.
DATABASE_LOGGING=false